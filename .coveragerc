# Configuration for the Python test suites in `scripts/` and `site/`. Run with:
#
#   coverage run -m unittest discover -s scripts -p 'test_*.py'
#   coverage run --append -m unittest discover -s site -p 'test_*.py'
#   coverage xml
#
# which produces a Cobertura-compatible `coverage.xml`.
[run]
branch = True
source =
    scripts
    site
omit =
    */test_*.py
    */__pycache__/*
    site/site/*

[report]
omit =
    */test_*.py
    */__pycache__/*
    site/site/*
