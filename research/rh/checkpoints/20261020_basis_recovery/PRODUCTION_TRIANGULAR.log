@AEGIS.CvSTriangularTransportV1.upper_triangular_surjective : ∀ {K : Type u_1} [inst : Field K] (n : ℕ)
  (A : Fin n → Fin n → K),
  (∀ (i j : Fin n), j < i → A i j = 0) → (∀ (i : Fin n), A i i ≠ 0) → Function.Surjective fun v i => ∑ j, A i j * v j
'AEGIS.CvSTriangularTransportV1.upper_triangular_surjective' depends on axioms: [propext, Classical.choice, Quot.sound]
