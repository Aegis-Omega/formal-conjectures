/- Exact cached packing of the actual residual column used in the output certificate. -/
import CvSPackedIntervalDotV1
import RowBudgetListCell0Pilot
open AEGIS.RHFixIntervalV1 AEGIS.CvSPackedIntervalDotV1
open AEGIS.CvSListIntervalDotV1 AEGIS.RowBudgetListCell0Pilot
namespace AEGIS.RowBudgetPackedZ0Pilot
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option Elab.async false
def cache : PackedIntervalRow := ⟨⟨, , 354388268776175195763820598160, 301⟩,
⟨, , 480461604929373352937031947990, 301⟩,
⟨, , 74310638526300981526596, 301⟩⟩
theorem packing_exact : cache = prepareInterval (2^280) (2^128) Z0 := by decide +kernel
theorem components_bounded : bounded (2^128) Z0 := by
  unfold bounded
  decide +kernel
theorem carry_bound : 301 * 301 * (2 * 2^128 * (2 * 2^128)) < (2^280 : ℕ) := by decide +kernel
theorem cached_dot_exact : cachedIntervalDot 96 (2^280) (2^128) cache cache = ⟨90409755428085542605520956409, 90409777030268093176323279969⟩ := by decide +kernel
theorem original_eq_cached : listDot 96 Z0 Z0 = cachedIntervalDot 96 (2^280) (2^128) cache cache := by
  symm
  apply cachedIntervalDot_eq 96 (2^280) (2^128) Z0 Z0 cache cache packing_exact packing_exact
  · rw [Z_length]; decide
  · rfl
  · exact components_bounded
  · exact components_bounded
  · rw [Z_length]; exact carry_bound

theorem reject_bad_packing :
    ({ cache with middle := { cache.middle with forward := cache.middle.forward + 1 } } : PackedIntervalRow) ≠
      prepareInterval (2^280) (2^128) Z0 := by decide +kernel
end AEGIS.RowBudgetPackedZ0Pilot
