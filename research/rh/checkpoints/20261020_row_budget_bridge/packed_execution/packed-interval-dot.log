AEGIS.CvSPackedIntervalDotV1.packedIntervalDot_eq : ∀ (p base bound : ℕ) (a b : List AEGIS.RHFixIntervalV1.Iv),
  0 < a.length →
    b.length = a.length →
      AEGIS.CvSPackedIntervalDotV1.bounded bound a →
        AEGIS.CvSPackedIntervalDotV1.bounded bound b →
          a.length * a.length * (2 * bound * (2 * bound)) < base →
