import WeilCanonicalMomentKillerPacketV1
import Mathlib.Tactic

/-!
The missing exact normalization identity connecting the ORIGINAL AEGIS
moment-killer operator to the ORIGINAL L2 logarithmic Weil lift.

For a smooth potential P:
  (D²+D)(e^(-t/2) P) = e^(-t/2) (P'' - P/4).

Thus for the canonical multiplicative packet generated by the left side,
  logLift(g)(t) = P''(t) - P(t)/4.

This matches the operator and correlation polynomial used by the independent
fixed-width signed-prime calculations. The previous narrow bump gHalf is NOT
identical to that separate polynomial/mollified packet.

Only the source-level derivative identity and canonical lift are proved here.
No signed prime evaluation, smoothing error, global Weil negativity or RH.
-/

open MeasureTheory Set Complex
open scoped ContDiff
set_option autoImplicit false
noncomputable section

namespace AEGIS.WeilSpectralMomentConjugationV1

open AEGIS.WeilMomentKillerConstructionV1
open AEGIS.WeilCanonicalMomentKillerPacketV1
open AEGIS.WeilLogCoordinateIsometryV21

/-- The exact exponential conjugating weight. -/
def weightedPotential (P : ℝ → ℝ) (t : ℝ) : ℝ :=
  Real.exp (-t / 2) * P t

private theorem exp_neg_half_hasDerivAt (t : ℝ) :
    HasDerivAt (fun u : ℝ => Real.exp (-u / 2))
      (-Real.exp (-t / 2) / 2) t := by
  have hlin : HasDerivAt (fun u : ℝ => -u / 2) (-1 / 2) t := by
    simpa only [] using (hasDerivAt_neg t).div_const 2
  have h := (Real.hasDerivAt_exp (-t / 2)).comp t hlin
  simpa only [Function.comp_def, div_eq_mul_inv, neg_mul] using h

theorem weightedPotential_contDiff (P : ℝ → ℝ)
    (hP : ContDiff ℝ ∞ P) :
    ContDiff ℝ ∞ (weightedPotential P) := by
  have he : ContDiff ℝ ∞ (fun t : ℝ => Real.exp (-t / 2)) := by
    fun_prop
  exact he.mul hP

theorem weightedPotential_hasCompactSupport (P : ℝ → ℝ)
    (hPc : HasCompactSupport P) :
    HasCompactSupport (weightedPotential P) := by
  exact hPc.mul_left

theorem weightedPotential_deriv (P : ℝ → ℝ)
    (hP : ContDiff ℝ ∞ P) (t : ℝ) :
    deriv (weightedPotential P) t =
      Real.exp (-t / 2) * (deriv P t - P t / 2) := by
  have hd : HasDerivAt (weightedPotential P)
      ((-Real.exp (-t / 2) / 2) * P t +
       Real.exp (-t / 2) * deriv P t) t :=
    (exp_neg_half_hasDerivAt t).mul ((differentiable_self hP t).hasDerivAt)
  rw [hd.deriv]
  ring

theorem weightedPotential_second_deriv (P : ℝ → ℝ)
    (hP : ContDiff ℝ ∞ P) (t : ℝ) :
    deriv (deriv (weightedPotential P)) t =
      Real.exp (-t / 2) *
        (deriv (deriv P) t - deriv P t + P t / 4) := by
  have hinner : HasDerivAt (fun u : ℝ => deriv P u - P u / 2)
      (deriv (deriv P) t - deriv P t / 2) t :=
    ((differentiable_deriv hP t).hasDerivAt).sub
      (((differentiable_self hP t).hasDerivAt).div_const 2)
  have hd := (exp_neg_half_hasDerivAt t).mul hinner
  have hfun : deriv (weightedPotential P) =
      fun u : ℝ => Real.exp (-u / 2) * (deriv P u - P u / 2) := by
    funext u
    exact weightedPotential_deriv P hP u
  rw [hfun]
  have hderiv :
      deriv (fun u : ℝ => Real.exp (-u / 2) * (deriv P u - P u / 2)) t =
        (-Real.exp (-t / 2) / 2) * (deriv P t - P t / 2) +
        Real.exp (-t / 2) * (deriv (deriv P) t - deriv P t / 2) := by
    change HasDerivAt (fun u : ℝ => Real.exp (-u / 2) * (deriv P u - P u / 2)) _ t at hd
    exact hd.deriv
  rw [hderiv]
  ring

/-- Conjugation exact: D^2 + D is P'' - P/4 after weighting. -/
theorem momentKiller_weightedPotential (P : ℝ → ℝ)
    (hP : ContDiff ℝ ∞ P) (t : ℝ) :
    momentKiller (weightedPotential P) t =
      Real.exp (-t / 2) * (deriv (deriv P) t - P t / 4) := by
  change deriv (weightedPotential P) t +
    deriv (deriv (weightedPotential P)) t = _
  rw [weightedPotential_deriv P hP t,
      weightedPotential_second_deriv P hP t]
  ring

/-- This equality uses the existing ROOT canonical Weil packet, not the
legacy duplicate subtype of the historical gWitness. -/
theorem canonicalSpectralPacket_logLift
    (P : ℝ → ℝ) (lo hi : ℝ)
    (hP : ContDiff ℝ ∞ P)
    (hl : ∀ t, t ≤ lo → momentKiller (weightedPotential P) t = 0)
    (hr : ∀ t, hi ≤ t → momentKiller (weightedPotential P) t = 0)
    (t : ℝ) :
    logLift
      (canonicalPacket (momentKiller (weightedPotential P)) lo hi
        (momentKiller_contDiff (weightedPotential_contDiff P hP)) hl hr).1 t =
      ((deriv (deriv P) t - P t / 4 : ℝ) : ℂ) := by
  rw [canonicalPacket_logLift,
      momentKiller_weightedPotential P hP t]
  have he : Real.exp (t / 2) * Real.exp (-t / 2) = 1 := by
    rw [← Real.exp_add,
      show t / 2 + -t / 2 = (0 : ℝ) by ring, Real.exp_zero]
  calc
    (Real.exp (t / 2) : ℂ) *
      ((Real.exp (-t / 2) *
        (deriv (deriv P) t - P t / 4) : ℝ) : ℂ) =
        ((Real.exp (t / 2) * Real.exp (-t / 2)) *
          (deriv (deriv P) t - P t / 4) : ℝ) := by
            push_cast
            ring
    _ = _ := by rw [he, one_mul]

/-- The same conjugated potential has the two actual multiplicative moments
zero, using the existing canonical transport and compact-support theorem. -/
theorem canonicalSpectralPacket_moments
    (P : ℝ → ℝ) (lo hi : ℝ)
    (hP : ContDiff ℝ ∞ P)
    (hPc : HasCompactSupport P)
    (hl : ∀ t, t ≤ lo → momentKiller (weightedPotential P) t = 0)
    (hr : ∀ t, hi ≤ t → momentKiller (weightedPotential P) t = 0) :
    WeilMomentConditionsV1
      (canonicalPacket (momentKiller (weightedPotential P)) lo hi
        (momentKiller_contDiff (weightedPotential_contDiff P hP)) hl hr) :=
  canonicalMomentKiller_moments
    (weightedPotential P) lo hi
    (weightedPotential_contDiff P hP)
    (weightedPotential_hasCompactSupport P hPc) hl hr

end AEGIS.WeilSpectralMomentConjugationV1

#print axioms AEGIS.WeilSpectralMomentConjugationV1.momentKiller_weightedPotential
#print axioms AEGIS.WeilSpectralMomentConjugationV1.canonicalSpectralPacket_logLift
#print axioms AEGIS.WeilSpectralMomentConjugationV1.canonicalSpectralPacket_moments
