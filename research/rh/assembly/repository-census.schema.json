                        "format": "date-time"
                      },
                      "verified_predicates": {
                        "type": "array",
                        "uniqueItems": true,
                        "minItems": 7,
                        "items": {
                          "type": "string",
                          "enum": [
                            "EXACT_HEAD",
                            "LEAN_KERNEL",
                            "NO_SORRY_AX",
                            "CANONICAL_TYPE",
                            "ALLOWED_AXIOMS",
                            "DEPENDENCY_CLOSURE",
                            "PASSPORT_ATTESTED"
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
