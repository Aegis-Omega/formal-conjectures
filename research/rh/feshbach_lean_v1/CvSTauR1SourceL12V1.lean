set_option maxRecDepth 100000 in
theorem tauSourceBatchR1_75 : tauSourceBatchR1 75 = true := by decide +kernel

theorem tauSourceBatchR1_all {s : ℕ}
    (hs : s ∈ [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65, 70, 75]) : tauSourceBatchR1 s = true := by
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hs
  rcases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [tauSourceBatchR1_0, tauSourceBatchR1_5, tauSourceBatchR1_10, tauSourceBatchR1_15, tauSourceBatchR1_20, tauSourceBatchR1_25, tauSourceBatchR1_30, tauSourceBatchR1_35, tauSourceBatchR1_40, tauSourceBatchR1_45, tauSourceBatchR1_50, tauSourceBatchR1_55, tauSourceBatchR1_60, tauSourceBatchR1_65, tauSourceBatchR1_70, tauSourceBatchR1_75]

/-- The certified source-integral check at every new frequency. -/
theorem tauSourceCheckR1_all {k : ℕ} (hk1 : 71 ≤ k) (hk : k ≤ 150) :
    tauCheck k (tauJExtra.getD (k - 71) 0) 20
      (tauSrcLoExtra.getD (k - 71) 0) (tauSrcHiExtra.getD (k - 71) 0) = true := by
  have hs : 5 * ((k - 71) / 5) ∈ [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65, 70, 75] := by
    have : (k - 71) / 5 < 16 := by omega
    interval_cases (k - 71) / 5 <;> simp
  have h := tauSourceBatchR1_all hs
  simp only [tauSourceBatchR1, List.all_eq_true, List.mem_range] at h
  have h' := h ((k - 71) % 5) (Nat.mod_lt _ (by norm_num))
  have hi : 5 * ((k - 71) / 5) + (k - 71) % 5 = k - 71 := by omega
  have he : 5 * ((k - 71) / 5) + (k - 71) % 5 + 71 = k := by omega
  have hkcancel : k - 71 + 71 = k := by omega
  simpa only [hi, hkcancel] using h'

/-- All new source-integral intervals, from the original analytic soundness theorem. -/
theorem source_integral_mem_R1 {k : ℕ} (hk1 : 71 ≤ k) (hk : k ≤ 150) :
    ((tauSrcLoExtra.getD (k - 71) 0 : ℚ) : ℝ) ≤
      ∫ r, hplus r * sourceS (6 / 5) r (k : ℤ) ∧
      ∫ r, hplus r * sourceS (6 / 5) r (k : ℤ) ≤
        ((tauSrcHiExtra.getD (k - 71) 0 : ℚ) : ℝ) :=
  tauCheck_sound (tauSourceCheckR1_all hk1 hk)

