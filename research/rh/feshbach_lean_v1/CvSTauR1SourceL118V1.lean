      ∫ r, hplus r * sourceS (11 / 8) r (k : ℤ) ≤ ((tauSrcHiExtra.getD (k - 71) 0 : ℚ) : ℝ) :=
  tauCheck_sound (tauSourceCheckR1_all hk1 hk2)

