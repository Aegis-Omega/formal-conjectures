  have hc : 0 ≤ ((certEps - certEta : ℤ) : ℝ) * ∑ i, ‖c i‖ ^ 2 :=
    mul_nonneg (by exact_mod_cast cert_margin_positive.le) hn
  have hp : (0 : ℝ) < 2 ^ certQ := by positivity
  nlinarith

