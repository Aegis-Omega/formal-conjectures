/-- The check for `k = s + 1, …, s + 10`. -/
def tauBatch (s : ℕ) : Bool :=
  (List.range 10).all fun i =>
    tauCheck (s + i + 1) (tauJ.getD (s + i) 0) 20 (tauLo.getD (s + i) 0) (tauHi.getD (s + i) 0)

set_option maxRecDepth 100000 in
theorem tauBatch0_true : tauBatch 0 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem tauBatch1_true : tauBatch 10 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem tauBatch2_true : tauBatch 20 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem tauBatch3_true : tauBatch 30 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem tauBatch4_true : tauBatch 40 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem tauBatch5_true : tauBatch 50 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem tauBatch6_true : tauBatch 60 = true := by decide +kernel

theorem tauBatch_all {s : ℕ} (hs : s ∈ [0, 10, 20, 30, 40, 50, 60]) : tauBatch s = true := by
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hs
  rcases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [tauBatch0_true, tauBatch1_true, tauBatch2_true, tauBatch3_true, tauBatch4_true,
    tauBatch5_true, tauBatch6_true]

theorem tauCheck_all {k : ℕ} (hk1 : 1 ≤ k) (hk : k ≤ 70) :
    tauCheck k (tauJ.getD (k - 1) 0) 20 (tauLo.getD (k - 1) 0) (tauHi.getD (k - 1) 0) = true := by
  have hs : 10 * ((k - 1) / 10) ∈ [0, 10, 20, 30, 40, 50, 60] := by
    have : (k - 1) / 10 < 7 := by omega
    interval_cases (k - 1) / 10 <;> simp
  have h := tauBatch_all hs
  simp only [tauBatch, List.all_eq_true, List.mem_range] at h
  have := h ((k - 1) % 10) (Nat.mod_lt _ (by norm_num))
  rw [Nat.div_add_mod (k - 1) 10, show k - 1 + 1 = k by omega] at this
  exact this

/-- **`∫ h₊ S_k` at `L = 6/5` for `k = 1, …, 70`**, each box of width at most `2·10⁻⁷`. -/
theorem source_integral_mem {k : ℕ} (hk1 : 1 ≤ k) (hk : k ≤ 70) :
    ((tauLo.getD (k - 1) 0 : ℚ) : ℝ) ≤ ∫ r, hplus r * sourceS (6 / 5) r (k : ℤ) ∧
      ∫ r, hplus r * sourceS (6 / 5) r (k : ℤ) ≤ ((tauHi.getD (k - 1) 0 : ℚ) : ℝ) :=
  tauCheck_sound (tauCheck_all hk1 hk)

