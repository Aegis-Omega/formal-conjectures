/-- The check for `k = s + 1, …, s + 5`. -/
def tauBatch (s : ℕ) : Bool :=
  (List.range 5).all fun i =>
    tauCheck (s + i + 1) (tauJ.getD (s + i) 0) 20 (tauLo.getD (s + i) 0) (tauHi.getD (s + i) 0)

set_option maxRecDepth 100000 in
theorem tauBatch0_true : tauBatch 0 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem tauBatch1_true : tauBatch 5 = true := by decide +kernel

