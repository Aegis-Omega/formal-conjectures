set_option maxRecDepth 100000 in
theorem tauBatch13_true : tauBatch 65 = true := by decide +kernel

theorem tauBatch_all {s : ℕ} (hs : s ∈ [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65]) :
    tauBatch s = true := by
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hs
  rcases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [tauBatch0_true, tauBatch1_true, tauBatch2_true, tauBatch3_true, tauBatch4_true,
    tauBatch5_true, tauBatch6_true, tauBatch7_true, tauBatch8_true, tauBatch9_true, tauBatch10_true,
    tauBatch11_true, tauBatch12_true, tauBatch13_true]

theorem tauCheck_all {k : ℕ} (hk1 : 1 ≤ k) (hk : k ≤ 70) :
    tauCheck k (tauJ.getD (k - 1) 0) 20 (tauLo.getD (k - 1) 0) (tauHi.getD (k - 1) 0) = true := by
  have hs : 5 * ((k - 1) / 5) ∈ [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65] := by
    have : (k - 1) / 5 < 14 := by omega
    interval_cases (k - 1) / 5 <;> simp
  have h := tauBatch_all hs
  simp only [tauBatch, List.all_eq_true, List.mem_range] at h
  have := h ((k - 1) % 5) (Nat.mod_lt _ (by norm_num))
  rw [Nat.div_add_mod (k - 1) 5, show k - 1 + 1 = k by omega] at this
  exact this

/-- **`∫ h₊ S_k` at `L = 11/8` for `k = 1, …, 70`**, each box of width at most `2·10⁻⁸`. -/
theorem source_integral_mem {k : ℕ} (hk1 : 1 ≤ k) (hk : k ≤ 70) :
    ((tauLo.getD (k - 1) 0 : ℚ) : ℝ) ≤ ∫ r, hplus r * sourceS (11 / 8) r (k : ℤ) ∧
      ∫ r, hplus r * sourceS (11 / 8) r (k : ℤ) ≤ ((tauHi.getD (k - 1) 0 : ℚ) : ℝ) :=
  tauCheck_sound (tauCheck_all hk1 hk)

